      "facts": {
        "cve": "CVE-2026-122041",
        "vendor": "Themehigh",
        "product": "Checkout Field Editor for WooCommerce (Pro)",
        "title": null,
        "description": "The Checkout Field Editor for WooCommerce (Pro) plugin for WordPress is vulnerable to unauthorized deletion of arbitrary attachments due to a missing capability/ownership check in the ajax_remove_uploaded() function in versions up to, and including, 3.8.0. The handler is registered for both wp_ajax and wp_ajax_nopriv and is gated solely by the 'file_handling_nonce' nonce, which is emitted inside the public checkout page markup (data-nonce attribute) whenever a File Upload checkout field is configured. This makes it possible for unauthenticated attackers to delete arbitrary attachments (including those belonging to other users or posts) by submitting a crafted attachment_id, which can lead to loss of important media and potential denial of service.",
        "cvss": {
          "version": "3.1",
          "score": 9.1,
          "severity": "CRITICAL",
