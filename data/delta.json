      "facts": {
        "cve": "CVE-2026-115933",
        "vendor": "GitroomHQ",
        "product": "postiz-app",
        "title": null,
        "description": "Postiz signs its session, invitation and password reset tokens with one shared secret and without any marker of what a token is for. A route that refreshes the credentials of a browser-extension channel signed data taken from the request itself and stored the result where the requesting user can read it back. A user could therefore obtain a validly signed token containing any claims they choose, which the application accepts as a session, as an organization invitation with a chosen role, as a password reset or as an enterprise provisioning token.\n\nA second, narrower route that creates team invitations signs extra fields from the request body in the same way.",
        "cvss": {
          "version": "3.1",
          "score": 9.9,
          "severity": "CRITICAL",
          "vector": "CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:C/C:H/I:H/A:H",
